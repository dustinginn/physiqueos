FROM node:24-alpine AS dependencies
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev

FROM node:24-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production PORT=8080
COPY --from=dependencies /app/package.json /app/package-lock.json ./
COPY --from=dependencies /app/node_modules ./node_modules
COPY src/contracts ./src/contracts
COPY src/platform ./src/platform
COPY scripts/runFoundationWeb.mjs scripts/runFoundationWorker.mjs ./scripts/
USER node
EXPOSE 8080
CMD ["node", "scripts/runFoundationWeb.mjs"]
