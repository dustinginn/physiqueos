FROM node:24-alpine AS dependencies
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev

FROM dependencies AS artifact
COPY src ./src
COPY scripts/runFoundationWorker.mjs scripts/sourceModuleResolutionHook.mjs \
    scripts/scanProviderArtifact.mjs scripts/collectProviderWorkerArtifact.mjs \
    scripts/collectProviderWorkerDependencies.mjs scripts/runSimplifiedProviderMigration.mjs \
    scripts/migrateNativeSandboxDatabase.mjs scripts/bootstrapNativeSandboxOwner.mjs ./scripts/
RUN node scripts/collectProviderWorkerArtifact.mjs /worker
COPY db/migrations /worker/db/migrations
RUN node scripts/collectProviderWorkerDependencies.mjs /worker
RUN node scripts/scanProviderArtifact.mjs /worker

FROM node:24-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production PHYSIQUEOS_PROVIDER_FULL_RUNTIME=1
COPY --from=artifact /worker ./
RUN node scripts/scanProviderArtifact.mjs /app
USER node
CMD ["node", "scripts/runFoundationWorker.mjs"]
