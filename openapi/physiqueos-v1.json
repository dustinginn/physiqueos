{
  "openapi": "3.1.0",
  "info": {
    "title": "PhysiqueOS Application API",
    "version": "1.0.0-foundation.3",
    "description": "Inactive Phase 3 shared application boundary. Versioned read-model, command, typed-destination, date, and authorized-media contracts are implemented over the still-canonical Founder JSON/file runtime. The only new HTTP surface is protected capability discovery; production authentication deliberately remains inactive and no Founder domain data is exposed."
  },
  "servers": [{ "url": "/api/v1" }],
  "paths": {
    "/health/live": {
      "get": {
        "operationId": "getFoundationLiveness",
        "summary": "Return non-sensitive process liveness",
        "parameters": [{ "$ref": "#/components/parameters/RequestId" }],
        "responses": {
          "200": {
            "description": "Process is alive",
            "headers": { "X-Request-ID": { "$ref": "#/components/headers/RequestId" } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Liveness" } } }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "getFoundationReadiness",
        "summary": "Return minimal shared-platform readiness",
        "parameters": [{ "$ref": "#/components/parameters/RequestId" }],
        "responses": {
          "200": {
            "description": "Every required shared-platform dependency is ready",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Readiness" } } }
          },
          "503": {
            "description": "One or more shared-platform dependencies are intentionally inactive or unavailable",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Readiness" } } }
          }
        }
      }
    },
    "/platform": {
      "get": {
        "operationId": "getPlatformStatus",
        "summary": "Return protected platform build, readiness, and capability state",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/RequestId" }],
        "responses": {
          "200": {
            "description": "Authenticated platform status",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PlatformStatus" } } }
          },
          "401": { "$ref": "#/components/responses/Problem" },
          "503": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/capabilities": {
      "get": {
        "operationId": "getApplicationCapabilities",
        "summary": "Return protected shared-application contract capabilities",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/RequestId" }],
        "responses": {
          "200": {
            "description": "Authenticated application capabilities",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApplicationCapabilities" } } }
          },
          "401": { "$ref": "#/components/responses/Problem" },
          "503": { "$ref": "#/components/responses/Problem" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "opaque" }
    },
    "parameters": {
      "RequestId": {
        "name": "X-Request-ID",
        "in": "header",
        "required": false,
        "schema": { "type": "string", "minLength": 8, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]+$" }
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": { "type": "string", "minLength": 16, "maxLength": 200, "pattern": "^[A-Za-z0-9._:/-]+$" }
      },
      "IfMatch": {
        "name": "If-Match",
        "in": "header",
        "required": true,
        "description": "ETag/resource version required for edits. A stale value returns 412.",
        "schema": { "type": "string" }
      },
      "Cursor": {
        "name": "cursor",
        "in": "query",
        "required": false,
        "schema": { "type": "string" }
      }
    },
    "headers": {
      "RequestId": { "description": "Server-accepted or generated request correlation ID", "schema": { "type": "string" } },
      "ResourceEtag": { "description": "Version validator for the returned resource/read model", "schema": { "type": "string" } }
    },
    "responses": {
      "Problem": {
        "description": "Versioned structured problem",
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
      }
    },
    "schemas": {
      "UuidV7": { "type": "string", "format": "uuid", "pattern": "^[0-9a-fA-F-]{36}$" },
      "AggregateVersion": { "type": "string", "pattern": "^[1-9][0-9]*$" },
      "CommandMetadata": {
        "type": "object",
        "additionalProperties": false,
        "required": ["commandId", "idempotencyKey", "payloadVersion"],
        "properties": {
          "commandId": { "$ref": "#/components/schemas/UuidV7" },
          "idempotencyKey": { "type": "string", "minLength": 16, "maxLength": 200 },
          "correlationId": { "type": ["string", "null"], "minLength": 8, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]+$" },
          "expectedVersion": { "oneOf": [{ "$ref": "#/components/schemas/AggregateVersion" }, { "type": "null" }] },
          "payloadVersion": { "type": "string" },
          "clientOccurredAt": { "type": ["string", "null"], "format": "date-time" },
          "clientTimeZone": { "type": ["string", "null"] }
        }
      },
      "Destination": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "parameters"],
        "properties": {
          "id": { "type": "string", "enum": ["home", "log", "check-in", "evidence.review", "evidence.detail", "goal.detail", "goals", "goal.transition", "plan", "plan.strategy", "plan.support", "priority.detail", "briefing.detail", "briefing.list", "training.session", "training.exercise", "photo.upload", "dexa.upload", "profile", "progress.stream", "platform.status", "operation.detail"] },
          "parameters": { "type": "object", "additionalProperties": true }
        }
      },
      "CursorPage": {
        "type": "object",
        "required": ["items", "nextCursor", "resourceVersion"],
        "properties": {
          "items": { "type": "array", "items": {} },
          "nextCursor": { "type": ["string", "null"] },
          "resourceVersion": { "$ref": "#/components/schemas/AggregateVersion" }
        }
      },
      "Problem": {
        "type": "object",
        "additionalProperties": false,
        "required": ["problemVersion", "type", "title", "status", "code", "fieldErrors"],
        "properties": {
          "problemVersion": { "const": "1" },
          "type": { "type": "string", "format": "uri" },
          "title": { "type": "string" },
          "status": { "type": "integer", "minimum": 400, "maximum": 599 },
          "code": { "type": "string" },
          "detail": { "type": ["string", "null"] },
          "instance": { "type": ["string", "null"] },
          "requestId": { "type": ["string", "null"] },
          "fieldErrors": { "type": "array", "items": { "type": "object" } },
          "recovery": { "type": ["object", "null"] }
        }
      },
      "Liveness": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "buildId", "apiVersion", "startedAt"],
        "properties": {
          "status": { "const": "ok" },
          "buildId": { "type": "string" },
          "apiVersion": { "const": "v1" },
          "startedAt": { "type": "string", "format": "date-time" }
        }
      },
      "ReadinessCheck": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "ready", "code"],
        "properties": { "name": { "type": "string" }, "ready": { "type": "boolean" }, "code": { "type": "string" } }
      },
      "Readiness": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "buildId", "apiVersion", "checks"],
        "properties": {
          "status": { "type": "string", "enum": ["ready", "not_ready"] },
          "buildId": { "type": "string" },
          "apiVersion": { "const": "v1" },
          "checks": { "type": "array", "items": { "$ref": "#/components/schemas/ReadinessCheck" } }
        }
      },
      "FeatureCapability": {
        "type": "object",
        "required": ["key", "enabled"],
        "properties": {
          "key": { "type": "string" }, "enabled": { "type": "boolean" },
          "platforms": { "type": ["array", "null"], "items": { "type": "string" } },
          "minimumBuild": { "type": ["integer", "null"] }
        }
      },
      "PlatformStatus": {
        "type": "object",
        "required": ["contractVersion", "apiVersion", "build", "readiness", "capabilities", "destination"],
        "properties": {
          "contractVersion": { "const": "1" },
          "apiVersion": { "const": "v1" },
          "build": { "type": "object" },
          "readiness": { "$ref": "#/components/schemas/Readiness" },
          "capabilities": { "type": "array", "items": { "$ref": "#/components/schemas/FeatureCapability" } },
          "destination": { "$ref": "#/components/schemas/Destination" }
        }
      },
      "ApplicationCommandContract": {
        "type": "object",
        "additionalProperties": false,
        "required": ["commandType", "payloadVersion", "requiredPayloadFields", "expectedVersionRequired"],
        "properties": {
          "commandType": { "type": "string", "enum": ["weight.submit.v1", "check-in.submit.v1", "evidence-intake.create.v1", "evidence-review.edit.v1", "evidence-review.confirm.v1", "evidence-review.dispose.v1", "priority.complete.v1", "previous-day.reconcile.v1", "protocol.edit.v1", "goal.edit.v1", "goal.transition.v1", "training-session.create.v1", "training-session.correct.v1", "training-logger.complete.v1", "nutrition-evidence.confirm.v1", "photo-evidence.confirm.v1", "dexa-evidence.confirm.v1"] },
          "payloadVersion": { "const": "1" },
          "requiredPayloadFields": { "type": "array", "items": { "type": "string" } },
          "expectedVersionRequired": { "type": "boolean" }
        }
      },
      "ApplicationReadModel": {
        "type": "object",
        "additionalProperties": false,
        "required": ["contractVersion", "model", "resourceVersion", "generatedAt", "freshThrough", "data", "intentionalDifferences", "etag"],
        "properties": {
          "contractVersion": { "const": "1" },
          "model": { "type": "string", "enum": ["home.v1", "log.v1", "evidence-review.v1", "goals.v1", "operating-plan.v1", "priorities.v1", "progress.v1", "confidence.v1", "briefings.v1", "training.v1", "profile.v1"] },
          "resourceVersion": { "type": "string" },
          "generatedAt": { "type": "string", "format": "date-time" },
          "freshThrough": { "type": "string", "format": "date-time" },
          "data": {},
          "intentionalDifferences": { "type": "array", "items": { "type": "string" } },
          "etag": { "type": "string" }
        }
      },
      "AuthorizedMediaReadDescriptor": {
        "type": "object",
        "additionalProperties": false,
        "required": ["objectId", "ownerUserId", "contentType", "size", "sha256", "expiresAt", "accessHandle"],
        "properties": {
          "objectId": { "type": "string" }, "ownerUserId": { "type": "string" }, "contentType": { "type": "string" },
          "size": { "type": "integer", "minimum": 0 }, "sha256": { "type": ["string", "null"] },
          "expiresAt": { "type": "string", "format": "date-time" }, "accessHandle": { "type": "string" }
        }
      },
      "ApplicationCapabilities": {
        "type": "object",
        "additionalProperties": false,
        "required": ["contractVersion", "apiVersion", "canonicalRuntime", "transportActivation", "readModels", "commands", "media", "fallbackDestination"],
        "properties": {
          "contractVersion": { "const": "1" }, "apiVersion": { "const": "v1" }, "build": {},
          "canonicalRuntime": { "const": "legacy_json_file" }, "transportActivation": { "const": "inactive" },
          "readModels": { "type": "array", "items": { "type": "string" } },
          "commands": { "type": "array", "items": { "$ref": "#/components/schemas/ApplicationCommandContract" } },
          "media": { "type": "object" }, "fallbackDestination": { "$ref": "#/components/schemas/Destination" }
        }
      },
      "Operation": {
        "type": "object",
        "required": ["operationVersion", "id", "status"],
        "properties": {
          "operationVersion": { "const": "1" },
          "id": { "type": "string" },
          "status": { "type": "string", "enum": ["queued", "running", "succeeded", "failed", "canceled"] },
          "result": {},
          "problem": { "oneOf": [{ "$ref": "#/components/schemas/Problem" }, { "type": "null" }] }
        }
      }
    }
  }
}
