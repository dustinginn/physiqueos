{
  "openapi": "3.1.0",
  "info": {
    "title": "PhysiqueOS Application API",
    "version": "1.0.0-native.1",
    "description": "Versioned PhysiqueOS application and Native production boundary. Founder-device bearer sessions authorize owner-scoped canonical read models, idempotent commands, and opaque private media without exposing persistence or storage implementation details."
  },
  "servers": [{ "url": "/api/v1" }],
  "paths": {
    "/health/live": {
      "get": {
        "operationId": "getFoundationLiveness",
        "summary": "Return non-sensitive process liveness",
        "parameters": [{ "$ref": "#/components/parameters/RequestId" }],
        "responses": {
          "200": {
            "description": "Process is alive",
            "headers": { "X-Request-ID": { "$ref": "#/components/headers/RequestId" } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Liveness" } } }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "getFoundationReadiness",
        "summary": "Return minimal shared-platform readiness",
        "parameters": [{ "$ref": "#/components/parameters/RequestId" }],
        "responses": {
          "200": {
            "description": "Every required shared-platform dependency is ready",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Readiness" } } }
          },
          "503": {
            "description": "One or more shared-platform dependencies are intentionally inactive or unavailable",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Readiness" } } }
          }
        }
      }
    },
    "/platform": {
      "get": {
        "operationId": "getPlatformStatus",
        "summary": "Return protected platform build, readiness, and capability state",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/RequestId" }],
        "responses": {
          "200": {
            "description": "Authenticated platform status",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PlatformStatus" } } }
          },
          "401": { "$ref": "#/components/responses/Problem" },
          "503": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/capabilities": {
      "get": {
        "operationId": "getApplicationCapabilities",
        "summary": "Return protected shared-application contract capabilities",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/RequestId" }],
        "responses": {
          "200": {
            "description": "Authenticated application capabilities",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApplicationCapabilities" } } }
          },
          "401": { "$ref": "#/components/responses/Problem" },
          "503": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/native/profile": {
      "get": {
        "operationId": "getNativeProfile",
        "summary": "Return the authenticated Native profile and authority capabilities",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "Owner-scoped profile", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/NativeResourceEnvelope" } } } }, "401": { "$ref": "#/components/responses/Problem" }, "404": { "$ref": "#/components/responses/Problem" } }
      }
    },
    "/native/contracts": {
      "get": {
        "operationId": "getNativeContracts",
        "summary": "Return the authoritative Native production contract manifest",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "Native contract manifest" }, "401": { "$ref": "#/components/responses/Problem" } }
      }
    },
    "/native/read/{resource}": {
      "get": {
        "operationId": "readNativeResource",
        "summary": "Read one allowlisted bounded canonical or Founder-only diagnostic Native resource",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "resource", "in": "path", "required": true, "schema": { "type": "string" } }, { "$ref": "#/components/parameters/Cursor" }, { "$ref": "#/components/parameters/StartDate" }, { "$ref": "#/components/parameters/EndDate" }],
        "responses": { "200": { "description": "Canonical Native resource", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/NativeResourceEnvelope" } } } }, "400": { "$ref": "#/components/responses/Problem" }, "401": { "$ref": "#/components/responses/Problem" }, "404": { "$ref": "#/components/responses/Problem" } }
      }
    },
    "/native/commands": {
      "post": {
        "operationId": "executeNativeCommand",
        "summary": "Execute one allowlisted idempotent canonical Native command",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "responses": { "200": { "description": "Canonical command receipt" }, "400": { "$ref": "#/components/responses/Problem" }, "401": { "$ref": "#/components/responses/Problem" }, "409": { "$ref": "#/components/responses/Problem" }, "412": { "$ref": "#/components/responses/Problem" } }
      }
    },
    "/native/media/{mediaId}": {
      "get": {
        "operationId": "readNativePrivateMedia",
        "summary": "Stream owner-scoped private media by opaque canonical ID",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "mediaId", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Private image or PDF" }, "404": { "$ref": "#/components/responses/Problem" } }
      }
    },
    "/native/evidence/intakes": {
      "post": {
        "operationId": "acceptNativeEvidenceIntake",
        "summary": "Aggregate multipart evidence intake (DEXA PDF, 1-4 screenshots, or a photo set in one bounded request); stores verified artifacts and returns a durable processing receipt",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": { "required": true, "content": { "multipart/form-data": {} } },
        "responses": { "202": { "description": "Durable intake receipt; interpretation continues asynchronously" }, "400": { "$ref": "#/components/responses/Problem" }, "401": { "$ref": "#/components/responses/Problem" }, "409": { "$ref": "#/components/responses/Problem" }, "413": { "$ref": "#/components/responses/Problem" } }
      }
    },
    "/native/evidence/intakes/{intakeId}": {
      "get": {
        "operationId": "readNativeEvidenceIntakeStatus",
        "summary": "Owner-scoped intake status; staged intakes also report media completion and per-artifact progress",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "intakeId", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Intake status" }, "401": { "$ref": "#/components/responses/Problem" }, "404": { "$ref": "#/components/responses/Problem" } }
      }
    },
    "/native/evidence/intakes/staged": {
      "post": {
        "operationId": "stageNativeEvidenceIntake",
        "summary": "Declare a staged-media Progress Photos intake and its expected artifact set (no bytes)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/StagedEvidenceIntakeDeclaration" } } } },
        "responses": { "202": { "description": "Durable intake receipt with artifact progress; replaying the same declaration returns the same intake" }, "400": { "$ref": "#/components/responses/Problem" }, "401": { "$ref": "#/components/responses/Problem" }, "409": { "$ref": "#/components/responses/Problem" }, "413": { "$ref": "#/components/responses/Problem" } }
      }
    },
    "/native/evidence/intakes/{intakeId}/artifacts/{artifactId}": {
      "put": {
        "operationId": "storeNativeStagedEvidenceArtifact",
        "summary": "Transfer exactly one declared artifact as a bounded raw image body; already stored artifacts are acknowledged without a second object",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "intakeId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "artifactId", "in": "path", "required": true, "schema": { "type": "string", "pattern": "^artifact_[0-9a-f]{32}_[1-9][0-9]{0,2}$" } }
        ],
        "requestBody": { "required": true, "content": { "image/jpeg": {}, "image/png": {}, "image/webp": {}, "image/heic": {}, "image/heif": {}, "image/x-adobe-dng": {} } },
        "responses": { "200": { "description": "Intake receipt with updated artifact progress; mediaComplete becomes true only when every declared artifact is verified" }, "400": { "$ref": "#/components/responses/Problem" }, "401": { "$ref": "#/components/responses/Problem" }, "404": { "$ref": "#/components/responses/Problem" }, "409": { "$ref": "#/components/responses/Problem" }, "411": { "$ref": "#/components/responses/Problem" }, "413": { "$ref": "#/components/responses/Problem" } }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "opaque" }
    },
    "parameters": {
      "RequestId": {
        "name": "X-Request-ID",
        "in": "header",
        "required": false,
        "schema": { "type": "string", "minLength": 8, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]+$" }
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": { "type": "string", "minLength": 16, "maxLength": 200, "pattern": "^[A-Za-z0-9._:/-]+$" }
      },
      "IfMatch": {
        "name": "If-Match",
        "in": "header",
        "required": true,
        "description": "ETag/resource version required for edits. A stale value returns 412.",
        "schema": { "type": "string" }
      },
      "Cursor": {
        "name": "cursor",
        "in": "query",
        "required": false,
        "schema": { "type": "string" }
      },
      "StartDate": {
        "name": "startDate",
        "in": "query",
        "required": false,
        "description": "Required for bounded HealthKit Activity canary diagnostics.",
        "schema": { "type": "string", "format": "date" }
      },
      "EndDate": {
        "name": "endDate",
        "in": "query",
        "required": false,
        "description": "Required for bounded HealthKit Activity canary diagnostics.",
        "schema": { "type": "string", "format": "date" }
      }
    },
    "headers": {
      "RequestId": { "description": "Server-accepted or generated request correlation ID", "schema": { "type": "string" } },
      "ResourceEtag": { "description": "Version validator for the returned resource/read model", "schema": { "type": "string" } }
    },
    "responses": {
      "Problem": {
        "description": "Versioned structured problem",
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
      }
    },
    "schemas": {
      "StagedEvidenceIntakeDeclaration": {
        "type": "object",
        "required": ["submissionIdentity", "effectiveDate", "expectedEvidenceType", "photoSession", "artifacts"],
        "properties": {
          "submissionIdentity": { "type": "string", "format": "uuid" },
          "effectiveDate": { "type": "string", "format": "date" },
          "expectedEvidenceType": { "type": "string", "enum": ["photo_session"] },
          "replacementForSubmissionIdentity": { "type": "string", "format": "uuid" },
          "photoSession": { "type": "object", "required": ["originalUnedited", "timeOfDay", "photoIdentities"], "properties": { "originalUnedited": { "type": "boolean" }, "timeOfDay": { "type": "string", "enum": ["morning", "afternoon", "evening"] }, "fasted": { "type": ["boolean", "null"] }, "postWorkout": { "type": ["boolean", "null"] }, "pump": { "type": ["boolean", "null"] }, "photoIdentities": { "type": "array", "items": { "type": "object" } } } },
          "artifacts": { "type": "array", "minItems": 1, "maxItems": 48, "items": { "type": "object", "required": ["artifactId", "ordinal", "role", "fileName", "mimeType", "byteLength", "sha256"], "properties": { "artifactId": { "type": "string" }, "ordinal": { "type": "integer", "minimum": 1 }, "role": { "type": "string", "enum": ["original", "analysis_derivative"] }, "derivativeOf": { "type": ["string", "null"] }, "fileName": { "type": "string" }, "mimeType": { "type": "string", "enum": ["image/jpeg", "image/png", "image/webp", "image/heic", "image/heif", "image/x-adobe-dng"] }, "byteLength": { "type": "integer", "minimum": 1, "maximum": 50331648, "description": "At most 33554432 for a compressed original (JPEG/PNG/WebP/HEIC/HEIF), 50331648 for a raw original (Apple ProRAW DNG), 8388608 for an analysis derivative" }, "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } } } }
        }
      },
      "UuidV7": { "type": "string", "format": "uuid", "pattern": "^[0-9a-fA-F-]{36}$" },
      "AggregateVersion": { "type": "string", "pattern": "^[1-9][0-9]*$" },
      "CommandMetadata": {
        "type": "object",
        "additionalProperties": false,
        "required": ["commandId", "idempotencyKey", "payloadVersion"],
        "properties": {
          "commandId": { "$ref": "#/components/schemas/UuidV7" },
          "idempotencyKey": { "type": "string", "minLength": 16, "maxLength": 200 },
          "correlationId": { "type": ["string", "null"], "minLength": 8, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]+$" },
          "expectedVersion": { "oneOf": [{ "$ref": "#/components/schemas/AggregateVersion" }, { "type": "null" }] },
          "payloadVersion": { "type": "string" },
          "clientOccurredAt": { "type": ["string", "null"], "format": "date-time" },
          "clientTimeZone": { "type": ["string", "null"] }
        }
      },
      "Destination": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "parameters"],
        "properties": {
          "id": { "type": "string", "enum": ["home", "log", "check-in", "evidence.review", "evidence.detail", "goal.detail", "goals", "goal.transition", "plan", "plan.strategy", "plan.support", "priority.detail", "briefing.detail", "briefing.list", "training.session", "training.exercise", "photo.upload", "dexa.upload", "profile", "progress.stream", "platform.status", "operation.detail"] },
          "parameters": { "type": "object", "additionalProperties": true }
        }
      },
      "CursorPage": {
        "type": "object",
        "required": ["items", "nextCursor", "resourceVersion"],
        "properties": {
          "items": { "type": "array", "items": {} },
          "nextCursor": { "type": ["string", "null"] },
          "resourceVersion": { "$ref": "#/components/schemas/AggregateVersion" }
        }
      },
      "Problem": {
        "type": "object",
        "additionalProperties": false,
        "required": ["problemVersion", "type", "title", "status", "code", "fieldErrors"],
        "properties": {
          "problemVersion": { "const": "1" },
          "type": { "type": "string", "format": "uri" },
          "title": { "type": "string" },
          "status": { "type": "integer", "minimum": 400, "maximum": 599 },
          "code": { "type": "string" },
          "detail": { "type": ["string", "null"] },
          "instance": { "type": ["string", "null"] },
          "requestId": { "type": ["string", "null"] },
          "fieldErrors": { "type": "array", "items": { "type": "object" } },
          "recovery": { "type": ["object", "null"] }
        }
      },
      "Liveness": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "buildId", "apiVersion", "startedAt"],
        "properties": {
          "status": { "const": "ok" },
          "buildId": { "type": "string" },
          "apiVersion": { "const": "v1" },
          "startedAt": { "type": "string", "format": "date-time" }
        }
      },
      "ReadinessCheck": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "ready", "code"],
        "properties": { "name": { "type": "string" }, "ready": { "type": "boolean" }, "code": { "type": "string" } }
      },
      "Readiness": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "buildId", "apiVersion", "checks"],
        "properties": {
          "status": { "type": "string", "enum": ["ready", "not_ready"] },
          "buildId": { "type": "string" },
          "apiVersion": { "const": "v1" },
          "checks": { "type": "array", "items": { "$ref": "#/components/schemas/ReadinessCheck" } }
        }
      },
      "FeatureCapability": {
        "type": "object",
        "required": ["key", "enabled"],
        "properties": {
          "key": { "type": "string" }, "enabled": { "type": "boolean" },
          "platforms": { "type": ["array", "null"], "items": { "type": "string" } },
          "minimumBuild": { "type": ["integer", "null"] }
        }
      },
      "PlatformStatus": {
        "type": "object",
        "required": ["contractVersion", "apiVersion", "build", "readiness", "capabilities", "destination"],
        "properties": {
          "contractVersion": { "const": "1" },
          "apiVersion": { "const": "v1" },
          "build": { "type": "object" },
          "readiness": { "$ref": "#/components/schemas/Readiness" },
          "capabilities": { "type": "array", "items": { "$ref": "#/components/schemas/FeatureCapability" } },
          "destination": { "$ref": "#/components/schemas/Destination" }
        }
      },
      "ApplicationCommandContract": {
        "type": "object",
        "additionalProperties": false,
        "required": ["commandType", "payloadVersion", "requiredPayloadFields", "expectedVersionRequired"],
        "properties": {
          "commandType": { "type": "string", "enum": ["weight.submit.v1", "check-in.submit.v1", "evidence-intake.create.v1", "evidence-review.edit.v1", "evidence-review.confirm.v1", "evidence-review.dispose.v1", "priority.complete.v1", "previous-day.reconcile.v1", "protocol.edit.v1", "goal.edit.v1", "goal.transition.v1", "training-session.create.v1", "training-session.correct.v1", "training-logger.complete.v1", "nutrition-evidence.confirm.v1", "photo-evidence.confirm.v1", "dexa-evidence.confirm.v1", "nutrition-day.upsert.v1", "activity-day.sync.v1", "training-session.commit.v1", "activity-day.upsert.v1", "healthkit.observations.ingest.v1", "dexa-review.measurements.v1", "evidence-review.commit.v1", "operating-plan.recurring-support.save.v1", "operating-plan.nutrition-strategy.save.v1", "training-catalog.my-library.add.v1", "training-catalog.exercise.create.v1", "operating-plan.training-strategy.save.v1", "operating-plan.peptide-support.save.v1", "operating-plan.supplement-support.save.v1", "operating-plan.supplement-strategy.save.v1", "operating-plan.supplement-lifecycle.change.v1", "operating-plan.coaching-updates.save.v1"] },
          "payloadVersion": { "const": "1" },
          "requiredPayloadFields": { "type": "array", "items": { "type": "string" } },
          "expectedVersionRequired": { "type": "boolean" }
        }
      },
      "ApplicationReadModel": {
        "type": "object",
        "additionalProperties": false,
        "required": ["contractVersion", "model", "resourceVersion", "generatedAt", "freshThrough", "data", "intentionalDifferences", "etag"],
        "properties": {
          "contractVersion": { "const": "1" },
          "model": { "type": "string", "enum": ["home.v1", "log.v1", "evidence-review.v1", "goals.v1", "operating-plan.v1", "priorities.v1", "progress.v1", "confidence.v1", "briefings.v1", "training.v1", "profile.v1"] },
          "resourceVersion": { "type": "string" },
          "generatedAt": { "type": "string", "format": "date-time" },
          "freshThrough": { "type": "string", "format": "date-time" },
          "data": {},
          "intentionalDifferences": { "type": "array", "items": { "type": "string" } },
          "etag": { "type": "string" }
        }
      },
      "NativeResourceEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": ["contractVersion", "resource", "authority", "generatedAt", "data"],
        "properties": {
          "contractVersion": { "const": "1" },
          "resource": { "type": "string" },
          "authority": { "const": "founder-production" },
          "generatedAt": { "type": "string", "format": "date-time" },
          "data": {}
        }
      },
      "AuthorizedMediaReadDescriptor": {
        "type": "object",
        "additionalProperties": false,
        "required": ["objectId", "ownerUserId", "contentType", "size", "sha256", "expiresAt", "accessHandle"],
        "properties": {
          "objectId": { "type": "string" }, "ownerUserId": { "type": "string" }, "contentType": { "type": "string" },
          "size": { "type": "integer", "minimum": 0 }, "sha256": { "type": ["string", "null"] },
          "expiresAt": { "type": "string", "format": "date-time" }, "accessHandle": { "type": "string" }
        }
      },
      "ApplicationCapabilities": {
        "type": "object",
        "additionalProperties": false,
        "required": ["contractVersion", "apiVersion", "canonicalRuntime", "transportActivation", "readModels", "commands", "media", "fallbackDestination"],
        "properties": {
          "contractVersion": { "const": "1" }, "apiVersion": { "const": "v1" }, "build": {},
          "canonicalRuntime": { "const": "legacy_json_file" }, "transportActivation": { "const": "inactive" },
          "readModels": { "type": "array", "items": { "type": "string" } },
          "commands": { "type": "array", "items": { "$ref": "#/components/schemas/ApplicationCommandContract" } },
          "media": { "type": "object" }, "fallbackDestination": { "$ref": "#/components/schemas/Destination" }
        }
      },
      "Operation": {
        "type": "object",
        "required": ["operationVersion", "id", "status"],
        "properties": {
          "operationVersion": { "const": "1" },
          "id": { "type": "string" },
          "status": { "type": "string", "enum": ["queued", "running", "succeeded", "failed", "canceled"] },
          "result": {},
          "problem": { "oneOf": [{ "$ref": "#/components/schemas/Problem" }, { "type": "null" }] }
        }
      }
    }
  }
}
