FROM node:24-alpine AS build
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1 \
    PHYSIQUEOS_PROVIDER_FULL_RUNTIME=1 \
    PHYSIQUEOS_CANONICAL_WINDOWS_ROOT=/windows-production-unavailable \
    PHYSIQUEOS_PROVIDER_ISOLATED_BUILD_ROOT=/app \
    PHYSIQUEOS_BUILD_DIST_DIR=.next \
    NEXT_PHASE=phase-production-build
ARG PHYSIQUEOS_BUILD_ID=provider-product-local
ARG PHYSIQUEOS_GIT_SHA=unknown
ENV PHYSIQUEOS_BUILD_ID=$PHYSIQUEOS_BUILD_ID \
    PHYSIQUEOS_GIT_SHA=$PHYSIQUEOS_GIT_SHA
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build -- --webpack
RUN test -f .next/standalone/.next/server/webpack-runtime.js
RUN rm -rf .next/standalone/src/data/founderSeed .next/standalone/src/data/seed \
    .next/standalone/src/fixtures .next/standalone/src/features/dashboard \
    .next/standalone/src/lib/mockData.js .next/standalone/src/models/UserProfile.js \
    .next/standalone/tmp .next/standalone/.tmp .next/standalone/private \
    .next/standalone/screenshots .next/standalone/test-results \
    .next/standalone/playwright-report .next/standalone/backups \
    .next/standalone/runtime-exports .next/standalone/scripts \
    .next/standalone/tests \
 && rm -f public/mockup-home.png
RUN node scripts/scanProviderArtifact.mjs .next/standalone public .next/static
RUN test ! -e .next/standalone/private \
 && test ! -e .next/standalone/tmp \
 && test ! -e .next/standalone/.tmp \
 && test ! -e .next/standalone/screenshots \
 && test ! -e .next/standalone/logs \
 && test ! -e .next/standalone/src/data/founderSeed \
 && test ! -e .next/standalone/src/fixtures \
 && test ! -e public/mockup-home.png

FROM node:24-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PHYSIQUEOS_PROVIDER_FULL_RUNTIME=1 \
    PORT=8080 \
    HOSTNAME=0.0.0.0
COPY --from=build --chown=node:node /app/public ./public
COPY --from=build --chown=node:node /app/.next/standalone ./
COPY --from=build --chown=node:node /app/.next/static ./.next/static
RUN rm -rf /app/tmp /app/.tmp /app/private /app/screenshots /app/test-results \
    /app/playwright-report /app/backups /app/runtime-exports \
 && test ! -e /app/tmp \
 && test ! -e /app/.tmp \
 && test ! -e /app/private \
 && test ! -e /app/screenshots
USER node
EXPOSE 8080
CMD ["node", "server.js"]
