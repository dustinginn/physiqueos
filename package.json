{
  "name": "physique-os-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "playwright:server": "node scripts/playwrightServer.mjs",
    "dev:tunnel": "npx ngrok http 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:foundation": "vitest --config vitest.foundation.config.js run",
    "validate:foundation": "node scripts/validateFoundationPhase1.mjs",
    "test:phase2": "vitest --config vitest.phase2.config.js run",
    "test:phase2:postgres": "node scripts/validatePhase2Postgres.mjs",
    "validate:phase2": "node scripts/validatePhase2Foundation.mjs",
    "test:phase3": "vitest --config vitest.phase3.config.js run",
    "validate:phase3": "node scripts/validatePhase3ApplicationBoundary.mjs",
    "test:phase4": "vitest --config vitest.phase4.config.js run",
    "test:phase4:postgres": "node scripts/validatePhase4Postgres.mjs",
    "validate:phase4": "node scripts/validatePhase4Foundation.mjs",
    "test:phase5": "vitest --config vitest.phase5.config.js run",
    "phase5:synthetic-package": "node scripts/createPhase5SyntheticPackage.mjs",
    "validate:phase5": "node scripts/validatePhase5Foundation.mjs",
    "test:phase6": "vitest --config vitest.phase6.config.js run",
    "validate:phase6": "node scripts/validatePhase6Compatibility.mjs",
    "test:migration-safety": "vitest --config vitest.migration-safety.config.js run",
    "worker:foundation": "node scripts/runFoundationWorker.mjs",
    "backup:foundation": "node scripts/foundationBackup.mjs",
    "infra:digitalocean:render": "node infra/digitalocean/renderAppSpec.mjs",
    "fonts:check": "node scripts/checkFontBuild.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "snap": "playwright test tests/home.spec.ts --project=chromium",
    "diff": "node scripts/diff.js",
    "db:migrate:up": "node-pg-migrate up -d PHYSIQUEOS_DATABASE_URL -m db/migrations -t physiqueos_schema_migrations --schema physiqueos --create-schema --migrations-schema physiqueos --create-migrations-schema",
    "db:migrate:down": "node-pg-migrate down -d PHYSIQUEOS_DATABASE_URL -m db/migrations -t physiqueos_schema_migrations --schema physiqueos --migrations-schema physiqueos",
    "db:migrate:dry-run": "node-pg-migrate up -d PHYSIQUEOS_DATABASE_URL -m db/migrations -t physiqueos_schema_migrations --schema physiqueos --create-schema --migrations-schema physiqueos --create-migrations-schema --dry-run",
    "ops:root:check": "node scripts/checkRootOperations.mjs",
    "ops:logs:check": "node scripts/cleanupOperationsLogs.mjs",
    "ops:logs:clean": "node scripts/cleanupOperationsLogs.mjs --apply"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1107.0",
    "@aws-sdk/s3-request-presigner": "^3.1107.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.2.8",
    "@fontsource/inter": "^5.2.8",
    "@simplewebauthn/server": "^13.3.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.21.0",
    "next": "16.2.9",
    "pdfjs-dist": "^6.1.200",
    "pg": "^8.23.0",
    "radix-ui": "^1.6.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.12.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@playwright/test": "^1.61.1",
    "@storybook/addon-a11y": "^10.4.6",
    "@storybook/addon-docs": "^10.4.6",
    "@storybook/addon-vitest": "^10.4.6",
    "@storybook/nextjs-vite": "^10.4.6",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26.0.1",
    "@vitest/browser-playwright": "^4.1.9",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "eslint-plugin-storybook": "^10.4.6",
    "node-pg-migrate": "^9.0.0",
    "pixelmatch": "^7.1.0",
    "playwright": "^1.61.1",
    "pngjs": "^7.0.0",
    "storybook": "^10.4.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  }
}
